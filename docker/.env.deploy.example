BACKEND_IMAGE=qasystem-backend:latest
BACKEND_BIND=0.0.0.0
BACKEND_HOST_PORT=8006
HOST_MODELS_DIR=./models

# 外部服务
DATABASE_URL=mysql+asyncmy://root:123456@host.docker.internal:3306/railway_db
MCP_DATABASE_URL=mysql+pymysql://root:123456@host.docker.internal:3306/railway_db
MCP_IMAGE_OUTPUT_DIR=/app/agentcode/image_result
FILE_SERVICE_URL=http://host.docker.internal
NEO4J_URI=bolt://host.docker.internal:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j2025
MILVUS_URI=http://host.docker.internal:19530
CONFIDENCE_ES_HOSTS=http://host.docker.internal:9200

# LLM
LLM_BACKEND=openai
LLM_BASE_URL=http://host.docker.internal:9999
LLM_API_VERSION=v1
LLM_MODEL=Qwen/Qwen3-8B
LLM_API_KEY=
# Docker Compose 不支持嵌套变量默认值，兼容变量在 .env 中直接回退到 LLM_*。
OPENAI_BASE_URL=${LLM_BASE_URL}
OPENAI_API_KEY=${LLM_API_KEY}
OPENAI_MODEL=${LLM_MODEL}
OPENCODE_CONFIG_CONTENT=

# 模型与文档解析
MODEL_PATH=/models/bge_m3_model
INTENT_MODEL_BASE_DIR=/models
MINERU_MODEL_SOURCE=local
MINERU_CONFIG_PATH=/app/algorithm/preproc/mineru.json
MINERU_MODEL_PIPELINE_PATH=/models/hub/models/OpenDataLab/PDF-Extract-Kit-1___0
MINERU_MODEL_VLM_PATH=/models/hub/models/OpenDataLab/MinerU2___5-2509-1___2B
