@startuml

skinparam defaultFontName Microsoft YaHei
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho

' ============================================
' 术语
' ============================================
class Term <<Terminology, KnowledgeUnit>> #LightCyan {
- name: String // 术语名称
- definition: String // 术语定义（标准定义）
- synonyms: String[] // 同义词列表，分号分隔
- domain: String // 所属业务域，如采购管理域
- tags: String[] // 标签
}

' ============================================
' 关系
' ============================================
' Term -[:TERM_DEFINES_METRIC]-> Metric (跨本体，后处理建立)
' Term -[:STORED_IN]-> KnowledgeSpace (后处理建立)

' @identity Term: name
@enduml
