# Source-free CPU environment for ALGORITHM_RUNTIME_PROFILE=remote-only.
# Application source is mounted read-only at runtime. No model weights or
# Backend/Agent/algorithm source is copied into this image.

ARG PYTHON_IMAGE=python:3.12-bookworm
FROM ${PYTHON_IMAGE}

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      tini \
      libgomp1 \
      libglib2.0-0 \
      libmagic1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.remote-only.txt /tmp/qasystem/requirements.remote-only.txt
RUN pip install --upgrade pip "setuptools>=77,<81" wheel && \
    pip install -r /tmp/qasystem/requirements.remote-only.txt && \
    pip check

RUN python - <<'PY'
import importlib.util
required = [
    "fastapi", "httpx", "jsonschema", "mcp", "openai", "pydantic",
    "redis", "uvicorn", "yaml", "langchain_core", "numpy", "pypdf",
    "sqlalchemy", "pymysql", "tiktoken",
]
missing = [name for name in required if importlib.util.find_spec(name) is None]
if missing:
    raise SystemExit(f"missing remote-only runtime modules: {missing}")
PY

ENTRYPOINT ["/usr/bin/tini", "--"]
