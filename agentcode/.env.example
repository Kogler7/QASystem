# agentcode 配置模板
# 复制为 .env 并填入你的实际值：
#   cp .env.example .env
#
# 优先级：agentcode/.env > 系统环境变量 > 默认值

# ── LLM 配置 ──────────────────────────────────────
LLM_BACKEND=openai
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_API_KEY=sk-your-api-key-here

# 备用环境变量名（兼容 OpenAI SDK）
# OPENAI_BASE_URL=${LLM_BASE_URL}
# OPENAI_MODEL=${LLM_MODEL}
# OPENAI_API_KEY=${LLM_API_KEY}

# ── Agent 配置 ────────────────────────────────────
AGENT_TEMPLATE_MAX_TOKENS=4096
AGENT_TEMPLATE_TEMPERATURE=0.2
AGENT_TEMPLATE_TIMEOUT_SECONDS=120
AGENT_TEMPLATE_TOOL_CHOICE=auto

# ── MCP 配置文件路径（可选）───────────────────────
# AGENT_MCP_CONFIG=/path/to/your/mcp_config.json

# ── 并发配置 ──────────────────────────────────────
# AGENT_API_WORKERS=1              # API 服务进程数（内嵌模式）
# AGENT_WORKER_CONCURRENCY=4       # 每进程工作线程数
# AGENT_WORKER_POOL_SIZE=4         # ToolManager 连接池大小

# ── Redis 配置（多进程模式必需）───────────────────
# TASK_STORE_REDIS_URL=redis://localhost:6379/0

# ── 上下文压缩 ────────────────────────────────────
COMPACT_TOKEN_THRESHOLD=100000