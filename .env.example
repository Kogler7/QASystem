# HTTP 与容器
# Compose 会把本文件作为进程环境注入；Server 不再重复读取容器内 dotenv。
# 本地直接启动且未注入 ENVIRONMENT 时，后端仍会自动加载仓库根 .env。
QASYSTEM_LOAD_DOTENV=false
# 对外部署默认监听所有网卡；通过宿主机防火墙或安全组限制访问来源。
BACKEND_BIND=0.0.0.0
BACKEND_HOST_PORT=8006
QASYSTEM_ENV_IMAGE=qasystem-env-v1
QASYSTEM_SOURCE_DIR=.
HOST_MODELS_DIR=./deploy/models
PYTHONUNBUFFERED=1
PYTHONPATH=/app:/app/agent
# 逗号分隔的宿主机 NVIDIA GPU 编号；目标 8 卡 A40 机器默认只使用后四张卡。
# supervisor 仅在所选卡内自动启动和调度进程，测试机器可按实际空闲卡覆盖。
GPU_DEVICE_IDS=4,5,6,7

# 统一执行层：默认异步；Redis 不可用时失败关闭，不回退到入口进程。
EXECUTION_MODE=async
EXECUTION_REDIS_URL=redis://redis:6379/1
EXECUTION_DATA_DIR=/app/backend/data/execution
EXECUTION_RUNTIME_READY_FILE=/tmp/qasystem-runtime-ready
EXECUTION_LOG_LEVEL=INFO
EXECUTION_GPU_SCHEDULING=true
EXECUTION_GPU_LEASE_TTL_SECONDS=900
EXECUTION_GPU_SAFETY_MARGIN_MB=512
EXECUTION_GPU_MAX_LEASES_PER_DEVICE=16
EXECUTION_GPU_MAX_LEASES_PER_WORKER=1
EXECUTION_GPU_MEMORY_REQUEST_MB_GPU_VLM=2048
EXECUTION_GPU_MEMORY_REQUEST_MB_GPU_EMBEDDING=2048
EXECUTION_GPU_MEMORY_REQUEST_MB_GPU_CONFIDENCE=2048
EXECUTION_WORKER_HEARTBEAT_SECONDS=5
EXECUTION_WORKER_HEARTBEAT_TTL_SECONDS=30
EXECUTION_CPU_WORKERS=auto
EXECUTION_VLM_WORKERS_PER_GPU=auto
EXECUTION_AUX_WORKERS_PER_GPU=1
# sync 表示进入统一队列并等待原工具结果；async 才返回任务句柄。
MCP_EXECUTION_MODE=sync

# 应用团队统一服务。FILE_SERVICE_URL 仅作为旧部署兼容变量，二者同时存在时新变量优先。
APPLICATION_SERVICE_URL=http://host.docker.internal
FILE_SERVICE_URL=
APPLICATION_SERVICE_TIMEOUT_SECONDS=30
# 鉴权上下文独立于任务和 Stream 留存；任务仅保存随机引用。
EXECUTION_AUTH_CONTEXT_TTL_SECONDS=3600

# SQL 直连是当前唯一保留的数据库兼容能力。
DATABASE_URL=mysql+pymysql://root:123456@host.docker.internal:3306/railway_db
MCP_DATABASE_URL=mysql+pymysql://root:123456@host.docker.internal:3306/railway_db
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0

# 图谱检索 LLM（知识空间定位、实体链接）
GRAPH_LLM_BASE_URL=http://host.docker.internal:9999
GRAPH_LLM_API_KEY=
GRAPH_LLM_MODEL=Qwen/Qwen3-8B
GRAPH_LLM_VERIFY_SSL=true
GRAPH_LLM_RETRIES=3
GRAPH_LLM_TIMEOUT_SECONDS=60

# 知识抽取 LLM
KG_EXTRACT_LLM_BASE_URL=http://host.docker.internal:9999
KG_EXTRACT_LLM_API_KEY=
KG_EXTRACT_LLM_MODEL=Qwen/Qwen3-8B
KG_EXTRACT_LLM_MAX_TOKENS=16384
KG_EXTRACT_LLM_JSON_RETRIES=2
# 同时在途的知识抽取请求数；应结合 LLM 服务的并发容量设置
KG_EXTRACT_LLM_MAX_CONCURRENCY=4
# 0 表示不限速；非 0 时同时满足每秒和每分钟两个滑动窗口限制
KG_EXTRACT_LLM_QPS=0
KG_EXTRACT_LLM_QPM=0

# Agent LLM
AGENT_LLM_BASE_URL=http://host.docker.internal:9999
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=Qwen/Qwen3-8B
AGENT_TEMPLATE_MAX_TOKENS=4096
AGENT_TEMPLATE_TEMPERATURE=0.2
AGENT_TEMPLATE_TIMEOUT_SECONDS=120
AGENT_API_WORKERS=1
AGENT_MCP_URL=http://backend:8000/mcp
AGENT_WORKER_CONCURRENCY=4
AGENT_WORKER_POOL_SIZE=4
AGENT_MCP_CONFIG=/app/agent/agentcode/tools/mcp_tools/mcp_config.json
TASK_STORE_REDIS_URL=redis://redis:6379/0
TASK_STORE_VISIBILITY_TIMEOUT=1500
TASK_STORE_EVENT_MAXLEN=10000
COMPACT_TOKEN_THRESHOLD=100000

# 本地模型
VECTOR_MODEL_PATH=/models/bge-small-zh-v1.5
CONFIDENCE_SBERT_MODEL_PATH=/models/bge-small-zh-v1.5

# 文档解析
MINERU_MODEL_SOURCE=local
MINERU_CONFIG_PATH=/app/algorithm/preproc/mineru.json
MINERU_MODEL_PIPELINE_PATH=/models/mineru/pipeline
MINERU_MODEL_VLM_PATH=/models/mineru/vlm
LIBREOFFICE_PATH=/usr/bin/soffice

# vLLM VLM 池。默认由容器内 supervisor 自动探测 GPU 并管理进程。
VLLM_MODEL_PATH=/models/mineru/vlm
VLLM_MODEL_VERSION=configured
VLLM_GPU_MEMORY_UTILIZATION=0.82
VLLM_MAX_NUM_SEQS=32
VLLM_WARMUP_ENABLED=true
VLLM_WARMUP_TIMEOUT_SECONDS=300
EXECUTION_VLM_SHARD_MIN_PAGES=8
# auto 会按存活 worker 生成约 1.5 轮页段；并发上限由 worker 租约动态控制。
EXECUTION_VLM_SHARD_COUNT=auto
EXECUTION_RESOURCE_WAIT_TIMEOUT_SECONDS=900
EMBEDDING_MODEL_NAME=embedding-confidence
EMBEDDING_MODEL_VERSION=configured

# MCP 输出
MCP_IMAGE_OUTPUT_DIR=/app/agent/image_result
