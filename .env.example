# ============ Docker 部署用环境变量 ============
# 复制为 .env 后放在项目根目录，再在根目录执行: docker compose up -d

# MySQL（与 backend DATABASE_URL 对应）
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=rail_assistant
MYSQL_USER=rail
MYSQL_PASSWORD=rail123

# 后端（JWT、Dify 等）
JWT_SECRET=change-me-in-production
DIFY_API_URL=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_KNOWLEDGE_API_KEY=
DIFY_USE_WORKFLOW=false
DIFY_WORKFLOW_API_KEY=
