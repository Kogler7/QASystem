# ============ Docker 部署用（唯一） ============
# 复制为 .env 放在项目根目录，在根目录执行: docker compose up -d
# 本地开发请用 backend/.env.example、frontend/.env.example 各自复制为 .env

# MySQL（与 backend 的 DATABASE_URL 对应）
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=rail_assistant
MYSQL_USER=rail
MYSQL_PASSWORD=rail123

# 后端（JWT、Dify 等）
JWT_SECRET=change-me-in-production
DIFY_API_URL=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_KNOWLEDGE_API_KEY=
DIFY_USE_WORKFLOW=false
DIFY_WORKFLOW_API_KEY=
