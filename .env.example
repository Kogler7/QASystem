# 对外部署默认监听所有网卡；通过宿主机防火墙或安全组限制访问来源。
BACKEND_BIND=0.0.0.0
BACKEND_HOST_PORT=8006
# Agent 容器对外发布的宿主机端口（容器内固定 9180）。
AGENT_HOST_PORT=9180
# Agent 对外监听地址；0.0.0.0 监听全部 IPv4 网卡。
AGENT_BIND=0.0.0.0
QASYSTEM_ENV_IMAGE=qasystem-env-v1
QASYSTEM_SOURCE_DIR=.
HOST_MODELS_DIR=./deploy/models
# 逗号分隔的宿主机 NVIDIA GPU 编号；目标 8 卡 A40 机器默认只使用后四张卡。
# supervisor 仅在所选卡内自动启动和调度进程，测试机器可按实际空闲卡覆盖。
GPU_DEVICE_IDS=4,5,6,7
# A40 默认：7 卡常驻 Clef + NanoJev，4/5/6 卡供通用任务；不改变允许使用的卡范围。
# 3090 显存较小，建议两模型分卡，并把模型卡和外部 judge 卡都加入保留列表。
EXECUTION_GPU_RESERVED_DEVICE_IDS=7

# 统一执行层：默认异步；Redis 不可用时失败关闭，不回退到入口进程。
EXECUTION_MODE=async
EXECUTION_REDIS_URL=redis://redis:6379/1
EXECUTION_DATA_DIR=/app/backend/data/execution
EXECUTION_RUNTIME_READY_FILE=/tmp/qasystem-runtime-ready
EXECUTION_LOG_LEVEL=INFO
EXECUTION_GPU_SCHEDULING=true
EXECUTION_GPU_LEASE_TTL_SECONDS=900
EXECUTION_GPU_SAFETY_MARGIN_MB=512
EXECUTION_GPU_MAX_LEASES_PER_DEVICE=16
EXECUTION_GPU_MAX_LEASES_PER_WORKER=1
EXECUTION_GPU_MEMORY_REQUEST_MB_GPU_VLM=2048
EXECUTION_GPU_MEMORY_REQUEST_MB_GPU_EMBEDDING=2048
EXECUTION_GPU_MEMORY_REQUEST_MB_GPU_CONFIDENCE=2048
EXECUTION_WORKER_HEARTBEAT_SECONDS=5
EXECUTION_WORKER_HEARTBEAT_TTL_SECONDS=30
EXECUTION_CPU_WORKERS=auto
EXECUTION_VLM_WORKERS_PER_GPU=auto
EXECUTION_AUX_WORKERS_PER_GPU=1
# 任务失败重试上限（含崩溃重投）：不可重试错误码（空文档/空切片/本体无效等）
# 按错误码协议直接终败，不消耗重试次数。
EXECUTION_MAX_ATTEMPTS=3
# worker 崩溃恢复：周期收割 Redis Streams PEL 中滞留的消息并重投；
# min-idle 防止误收正在执行的消息，attempt 达上限判 failed 防死信循环。
EXECUTION_REAPER_ENABLED=true
EXECUTION_REAPER_MIN_IDLE_SECONDS=600
EXECUTION_REAPER_INTERVAL_SECONDS=60
# sync 表示进入统一队列并等待原工具结果；async 才返回任务句柄。
MCP_EXECUTION_MODE=sync

# 应用团队统一服务，统一使用 APPLICATION_SERVICE_URL。
APPLICATION_SERVICE_URL=http://host.docker.internal
APPLICATION_SERVICE_TIMEOUT_SECONDS=30
# 鉴权上下文独立于任务和 Stream 留存；任务仅保存随机引用。
EXECUTION_AUTH_CONTEXT_TTL_SECONDS=3600

# SQL 直连是当前唯一保留的数据库兼容能力。
DATABASE_URL=mysql+pymysql://root:123456@host.docker.internal:3306/railway_db
MCP_DATABASE_URL=mysql+pymysql://root:123456@host.docker.internal:3306/railway_db
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0

# 图谱检索 LLM（知识空间定位、实体链接）
GRAPH_LLM_BASE_URL=http://host.docker.internal:9999
GRAPH_LLM_API_KEY=
GRAPH_LLM_MODEL=Qwen/Qwen3-8B
GRAPH_LLM_VERIFY_SSL=true
GRAPH_LLM_RETRIES=3
GRAPH_LLM_TIMEOUT_SECONDS=60

# 评测凭据；judge 地址、模型、适配器、输出上限只通过每次评测命令行设置。
QASYSTEM_JUDGE_API_KEY=

# 知识抽取 LLM
KG_EXTRACT_LLM_BASE_URL=http://host.docker.internal:9999
# 抽取模型单次请求超时（秒）；支持审核后的动态配置，对新提交任务生效。
KG_EXTRACT_LLM_TIMEOUT_SECONDS=300
KG_EXTRACT_LLM_API_KEY=
KG_EXTRACT_LLM_MODEL=Qwen/Qwen3-8B
KG_EXTRACT_LLM_MAX_TOKENS=16384
# 输入预算按本地保守估算检查；输出新变量为空时兼容上面的 MAX_TOKENS。
KG_EXTRACT_LLM_MAX_INPUT_TOKENS=65536
# 本地中间结果目录；空值关闭。含文档内容，必须指向受控可写卷（相对路径基于进程 cwd）。
KG_EXTRACT_TRACE_DIR=tmp/extraction-traces
# v3 抽取恢复子片与上游共用分隔符切片器；默认 overlap=50 字符。
KG_EXTRACT_ENTITY_SEGMENT_OVERLAP=50
KG_EXTRACT_LLM_MAX_OUTPUT_TOKENS=
KG_EXTRACT_LLM_JSON_RETRIES=2
# 默认 1：关闭模型 thinking；设 0 后允许模型思考。
KG_EXTRACT_LLM_DISABLE_THINKING=1
# 可选 Jev 关系判别（默认关闭）。本地权重挂载到 /models，不进镜像。
# 目前仅 v2 流水线读取该组配置；v3 / v3.1 / latest 不启用。
KG_EXTRACT_JEV_ENABLED=0
KG_EXTRACT_JEV_MODEL_PATH=/models/nanojev
KG_EXTRACT_JEV_ACCEPT=0.9
KG_EXTRACT_JEV_REJECT=0.9
KG_EXTRACT_JEV_CHOICE_CONFIDENCE=0.9
KG_EXTRACT_JEV_PRECISION=bf16
KG_EXTRACT_JEV_BATCH_QUESTIONS=32
# 同时在途的知识抽取请求数；应结合 LLM 服务的并发容量设置
KG_EXTRACT_LLM_MAX_CONCURRENCY=4
# 0 表示不限速；非 0 时同时满足每秒和每分钟两个滑动窗口限制
KG_EXTRACT_LLM_QPS=0
KG_EXTRACT_LLM_QPM=0
# 请求级供应商选择：这里只登记地址、模型、配额组和密钥环境变量名，禁止放密钥值。
# 同一账号的别名应共用 quota_group；与默认供应商共额度时也设成同一个组。
KG_EXTRACT_LLM_QUOTA_GROUP=default
KG_EXTRACT_PROVIDERS_JSON={}
# 示例（单行 JSON，取消注释替换上行；限额须按实际供应商账号配置）：
# KG_EXTRACT_PROVIDERS_JSON={"siliconflow":{"base_url":"https://api.siliconflow.cn/v1","api_key_env":"SILICONFLOW_API_KEY","model":"deepseek-ai/DeepSeek-V4-Flash","quota_group":"siliconflow-account","max_concurrency":2,"qps":1,"qpm":30,"api_mode":"chat","thinking_parameter":"enable_thinking"}}
SILICONFLOW_API_KEY=
DEEPSEEK_API_KEY=
# 本地无鉴权 LLM 的占位凭据，仅用于供应商配置的非空校验；不要复用云端密钥。
QASYSTEM_LOCAL_LLM_API_KEY=local-llm
# observe 仅标记缺少稳定身份的实体；quarantine 阻止其及关联关系进入正式图谱
KG_EXTRACT_IDENTITY_ADMISSION=quarantine
# 证据准入（v3/latest）：warn（默认）证据无法逐字定位或核验不一致时保留实体并标记
# evidence_status=unverified，终验 EVIDENCE_INVALID 降为 warning 不阻断发布；
# reject 恢复旧行为（拒收候选，EVIDENCE_INVALID 计硬错误扣押整图）
KG_EXTRACT_EVIDENCE_ADMISSION=warn
# 验证-修复循环轮数上限（0-2，默认 2）；v3/latest 的 repair 只新增关系，不新增实体
KG_EXTRACT_MAX_REPAIR_ROUNDS=2
# 旧版实体/关系主调用的 LLM 最大尝试次数（瞬时失败/JSON 错误重试，默认 3）。
KG_EXTRACT_LLM_MAX_ATTEMPTS=3
# 抽取算法版本：latest | v2 | v3 | v3.1 | jev，默认 latest（独立代码包）。
# v3.1 对应 Python 包 v3_1（实体与属性抽取、独立属性证据核验及定向修复）。
# jev 只运行 knowledge_extract/jev_extract，不影响默认抽取。说明见 docs/算法/JEV决策层.md。
# 在 test_data/eval-v2-opt 上评测 v2 带路由时设为 v2，并保持下方路由开关为 1。
KG_EXTRACT_ALGO_VERSION=latest
# v3.1 使用同一主模型分阶段生成与证据核验；未接入 Clef。
# 文档总预算（秒）：留空按输入规模自适应（300 + 90 × 千字符 + 240 × 片数，钳在 900–2400），填写即完全覆盖。
KG_EXTRACT_V31_DOCUMENT_TIMEOUT=
KG_EXTRACT_V31_REQUEST_TIMEOUT=120
# V3.1 单次完整提示词字节上限，含 system/skill/本体/状态；超限拆分。
KG_EXTRACT_V31_MAX_INPUT_BYTES=48000
# V3.1 请求窗口字符数；沿用内部重叠，截断时继续缩小。
KG_EXTRACT_V31_WINDOW_CHARS=2000
# 独立证据核验每批最大条数（1–24）；仍受完整输入/输出预算约束，超限拆小
KG_EXTRACT_V31_VERIFICATION_BATCH_SIZE=16
# 实体准入可单独缩小核验批次；不大于上方批次，未配置时沿用上方值
KG_EXTRACT_V31_ENTITY_VERIFICATION_BATCH_SIZE=16
# 同一抽取请求全部阶段、重试与拆分合计的模型调用上限
KG_EXTRACT_V31_MAX_CALLS=512
# 实验性补扫未出现类型；实测可能产生越界候选，默认关闭
KG_EXTRACT_V31_TYPE_COMPLETION_AUDIT=false
# 仅实体/属性生成与候选身份复查的采样温度；核验及 Skill 选择保持 0；默认保持原值
KG_EXTRACT_V31_GENERATION_TEMPERATURE=0
# 最多保留前 N 次调用的完整提示词；其余保留字节数、耗时、状态和 usage
KG_EXTRACT_V31_TRACE_CALLS=32
# 默认 1：verification 未通过时抽取响应仍返回 best-effort 图谱（graph/graphs 保留
# 已抽取的节点与关系），graph_publishable=false 仅作为下游沉淀/入库的"不可信"信号；
# 设 0 恢复旧行为：graph/graphs 置空，未过校验的图谱仅出现在 isolated_graph/isolated_graphs。
KG_EXTRACT_PUBLISH_BEST_EFFORT=1
# 领域 JEV 决策层（默认关闭，且只在 KG_EXTRACT_ALGO_VERSION=jev 的副本里读取）。
# 不要打开上面的 KG_EXTRACT_JEV_ENABLED。没有领域 checkpoint 时预测记为 skipped，不改抽取结果。
KG_JEV_ENABLED=0
KG_JEV_DOCUMENT_COREF=0
KG_JEV_RELATION_SUPPORT=0
KG_JEV_GRAPH_ALIGN=0
KG_JEV_MODEL_PATH=
KG_JEV_CHOICE_CONFIDENCE=0.9

# Agent LLM
AGENT_LLM_BASE_URL=http://host.docker.internal:9999
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=Qwen/Qwen3-8B
AGENT_TEMPLATE_MAX_TOKENS=4096
AGENT_TEMPLATE_TEMPERATURE=0.2
AGENT_TEMPLATE_TIMEOUT_SECONDS=120
AGENT_API_WORKERS=1
# Agent 专属 MCP 服务（compose 内网地址；本地开发用 http://127.0.0.1:9181/mcp）
AGENT_MCP_URL=http://agent-mcp:9181/mcp
# Agent MCP 服务自身监听（agent-mcp 容器）
AGENT_MCP_HOST=0.0.0.0
AGENT_MCP_PORT=9181
AGENT_WORKER_CONCURRENCY=4
AGENT_WORKER_POOL_SIZE=4
AGENT_MCP_CONFIG=/app/agent/agentcode/tools/mcp_tools/mcp_config.json
TASK_STORE_REDIS_URL=redis://redis:6379/0
TASK_STORE_VISIBILITY_TIMEOUT=1500
TASK_STORE_EVENT_MAXLEN=10000
COMPACT_TOKEN_THRESHOLD=100000

# 本地模型
ALGORITHM_RUNTIME_PROFILE=full-runtime
VECTOR_MODEL_PATH=/models/bge-small-zh-v1.5

# 远程 Embedding（remote-only 模式必填；full-runtime 模式可留空）
EMBEDDING_SERVICE_URL=
EMBEDDING_SERVICE_PATH=/v1/embeddings
EMBEDDING_SERVICE_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_BATCH_SIZE=32

# 决策模型通过 decisions profile 常驻，复用环境镜像内独立 venv。
# 使用 Compose 服务时填 http://clef:8188；宿主服务用 http://host.docker.internal:8188。
# 留空时调用显式失败；接入服务不会自动切换抽取算法。
CLEF_SERVICE_URL=http://clef:8188
CLEF_SERVICE_PATH=/v1/systemone
CLEF_SERVICE_API_KEY=
CLEF_SERVICE_TIMEOUT_SECONDS=120
CLEF_MODEL=clef-flash
# 可选实体数量再切分：请求开关与 entity_count_model 选择，复用现有模型服务及队列。
# 每个原始片的预测档位、计划/实际分片、range和实际overlap，追加本地JSONL。
CHUNK_ENTITY_LOG_PATH=/app/backend/tmp/chunk_entity_decisions.jsonl
# 如启用服务鉴权，须与 Backend 的 CLEF_SERVICE_API_KEY 相同。
CLEF_API_KEY=

# NanoJev 常驻服务；各 GPU worker 走 HTTP，不重复加载 checkpoint。
NANOJEV_SERVICE_URL=http://nanojev:8189
NANOJEV_SERVICE_PATH=/v1/systemone
NANOJEV_SERVICE_API_KEY=
NANOJEV_SERVICE_TIMEOUT_SECONDS=30
NANOJEV_API_KEY=

# 远程文档解析（remote-only 模式必填；full-runtime 模式可留空）
DOCUMENT_PARSE_SERVICE_URL=
DOCUMENT_PARSE_SERVICE_PATH=/v1/documents/parse
DOCUMENT_PARSE_SERVICE_API_KEY=
DOCUMENT_PARSE_TIMEOUT_SECONDS=900

# 文档解析
# MinerU 2.x 已退役：VLM 端点未配置时的本地回退层是 MinerU 4.x（见下方 MINERU_MODEL_BASE_DIR）。
MINERU_MODEL_SOURCE=local
LIBREOFFICE_PATH=/usr/bin/soffice

# MinerU 4.0（本地推理，不调用远程 API），与 docling 装在同一个环境。
# 解析子进程直接复用主 Python；不需要配置独立解释器路径。
# 模型放在 ${HOST_MODELS_DIR}/mineru4，容器内即 /models/mineru4：
#   MinerU-4_models_onnx（basic 档小模型，约 819MB）
#   MinerU2.5-Pro-2605-1.2B-GGUF（standard/advanced 档 VLM，llama.cpp，约 1.2GB）
MINERU_HOME=/app/backend/data/mineru4
MINERU_MODEL_BASE_DIR=/models/mineru4
MINERU_MODEL_SMALL_BACKEND=onnx
# VLM 引擎：llama-cpp（CPU，默认）/ vllm（GPU 提速，用镜像自带 vLLM，见下方 VLLM 段）。
# 配 vllm 时需另外准备非 GGUF 权重并设置 MINERU_MODEL_VLM_SERVER_URL（或用本地 vLLM 服务）。
MINERU_MODEL_VLM_ENGINE=llama-cpp
# 4.0 会在模型根目录下写 .locks；模型本体只读挂载时，需要把该目录单独叠成可写。
# 宿主上必须先创建 ${MINERU4_LOCK_DIR}，并保证容器用户可写。
MINERU4_LOCK_DIR=./deploy/models/mineru4/.locks
# 解析档位：flash / basic / standard / advanced。默认 standard；
# advanced 是 xhigh effort（走 hybrid VLM 管线，CPU 上约慢 5 倍，模型与 standard 相同）。
# 注意：DOC/DOCX/PPT/PPTX/XLS/XLSX/OFD/CSV/HTML/EPUB 在 4.0 只有 flash 档，运行时会自动降到 flash。
MINERU4_TIER=standard

VLLM_WARMUP_ENABLED=true
VLLM_WARMUP_TIMEOUT_SECONDS=300
EXECUTION_VLM_SHARD_MIN_PAGES=8
# auto 会按存活 worker 生成约 1.5 轮页段；并发上限由 worker 租约动态控制。
EXECUTION_VLM_SHARD_COUNT=auto
# 知识沉淀流水线（POST /api/v1/pipelines/knowledge-ingestion）内解析页分片开关（默认 false）：
# true 时流水线内的 PDF 解析走页分片编排加速（复用上方页段阈值，按存活 VLM worker 并行）。
# 非 PDF 文件、options 显式 page_sharding=off、inline 执行环境（无队列）自动回退整篇解析。
KNOWLEDGE_PIPELINE_PARSE_SHARDING=false

# MCP 输出
MCP_IMAGE_OUTPUT_DIR=/app/agent/image_result

# 可观测性告警
# 告警只写本地日志，不访问外网。
# 各阶段耗时预算（秒）：知识沉淀流水线对应阶段超过预算即记录 slow_stage 告警日志
# （只告警，不中断任务）。留空或 0 表示不告警。
QASYSTEM_ALERT_STAGE_SLOW_PARSE_SECONDS=
QASYSTEM_ALERT_STAGE_SLOW_CHUNK_SECONDS=
QASYSTEM_ALERT_STAGE_SLOW_EXTRACT_SECONDS=

# API 请求完整记录（普通 API 测试落盘）
# 开启后每次 API 请求在记录根目录下新建 <日期时间戳>_<request_id>/ 文件夹，保存上传文件
# 原文、请求参数、本体、中间产物（解析 markdown / 切片 / 抽取结果）、最终响应、各阶段耗时
# 与处理期间的详细日志；记录失败只告警，绝不影响接口响应。0/false/no/off 关闭。
KG_API_RECORD_ENABLED=1
# 记录根目录；留空默认 backend/data/api_records（容器内位于可写的 backend-data 卷，
# 源码目录为只读挂载，不会往里写）。目录不可创建时该次请求自动降级为不记录。
KG_API_RECORD_DIR=
# 记录保留天数：服务启动时与每次新建记录前自动清理超期的记录目录；<=0 表示不清理。
KG_API_RECORD_RETENTION_DAYS=7
