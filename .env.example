# =============================================================================
# 仓库根 .env（仅用于 Docker Compose）
# 复制为 /.env 后执行：docker compose up -d
#
# 边界约定：
# 1) 本文件服务于根目录 docker-compose（仅前后端）
# 2) 数据库与中间件统一由 database/docker-compose.yml 管理
# 3) 本文件只保存应用连接 database 栈所需参数
# 4) 本机 uvicorn 调试请使用 backend/.env（见 backend/.env.example）
# =============================================================================

# ----- Compose 基础 -----
HTTP_PORT=80
# 后端 API 映射到宿主机（宿主机端口 -> 容器 8000）。
BACKEND_BIND=127.0.0.1
BACKEND_HOST_PORT=8006
BACKEND_IMAGE=qasystem-backend:latest
FRONTEND_IMAGE=qasystem-frontend:latest
MYSQL_DATABASE=railway_db
MYSQL_USER=root
MYSQL_PASSWORD=123456
# backend 连接数据库地址
# - database 与应用分开部署时，填 host.docker.internal 或 database 所在主机 IP
DATABASE_HOST=host.docker.internal
DATABASE_PORT=3306
# 宿主机模型目录（将以只读方式挂载到 backend 容器 /models）
# 当 models 与 .env/docker-compose 同级时，使用 ./models
HOST_MODELS_DIR=./models

# ----- backend 容器运行所需（通过 env_file 注入）-----
ENVIRONMENT=development
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Dify
DIFY_API_URL=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_KNOWLEDGE_API_KEY=
DIFY_USE_WORKFLOW=false
DIFY_WORKFLOW_API_KEY=
DIFY_WORKFLOW_INPUT_VAR=query
DIFY_WORKFLOW_OUTPUT_VAR=text
DIFY_WORKFLOW_RESPONSE_MODE=blocking
DIFY_WORKFLOW_TIMEOUT_SECONDS=120

# 外部依赖地址（容器内访问宿主机示例）
# 若使用 compose --profile neo4j，请改为 NEO4J_URI=bolt://neo4j:7687
NEO4J_URI=bolt://host.docker.internal:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j2025
# 兼容少数模块历史变量名（可选；不填时后端会自动回退到 NEO4J_USER）
# NEO4J_USERNAME=neo4j

LLM_BACKEND=openai
LLM_BASE_URL=http://host.docker.internal:9999
LLM_API_VERSION=v1
LLM_MODEL=Qwen/Qwen3-8B
LLM_API_KEY=
# QA 模块历史变量（可选；不填时后端会自动回退到 LLM_MODEL）
# LLM_TYPE=Qwen/Qwen3-8B
OLLAMA_URL=


MILVUS_URI=http://host.docker.internal:19530
MILVUS_CONSISTENCY_LEVEL=Strong
COLLECTION_NAME=intent_rag
DEEPSEEK_API_KEY=

# 组件可选项（仅在需要对应组件时填写；不需要可留空）
MODEL_PATH=/models/bge_m3_model
INTENT_MODEL_BASE_DIR=/models
UIE_LLM_MODEL=rule_v4
UIE_CHUNK_MAX_CHARS=1200
MINERU_MODEL_SOURCE=local
MINERU_CONFIG_PATH=/app/algorithm/preproc/mineru.json
# 可选：直接通过环境变量覆盖 mineru.json 的 models-dir（部署推荐）
MINERU_MODEL_PIPELINE_PATH=/models/hub/models/OpenDataLab/PDF-Extract-Kit-1___0
MINERU_MODEL_VLM_PATH=/models/hub/models/OpenDataLab/MinerU2___5-2509-1___2B
LIBREOFFICE_PATH=
NL2CYPHER_CHROMA_DB_PATH=chroma_db
NL2CYPHER_EMBEDDING_MODEL_PATH=/models/bge-small-zh-v1.5
NL2CYPHER_RECORDS_JSON=records.json
CONFIDENCE_ES_HOSTS=http://host.docker.internal:9200
CONFIDENCE_SBERT_MODEL_PATH=/models/sbert_model
KG_CONFIDENCE_THRESHOLD=
CORS_ORIGINS=

# 图谱问答 QA（algorithm/ans/QA）
# 说明：
# - 推荐统一在根 .env 配置；QA/.env 仅用于单独运行该目录脚本。
# - LLM_TYPE 为历史键，不填时后端会回退到 LLM_MODEL。
# LLM_TYPE=Qwen/Qwen3-8B
MAX_LENGTH=256
TEMPERATURE_EXPLORATION=0.4
TEMPERATURE_REASONING=0.0
WIDTH=3
DEPTH=3
NUM_RETAIN_ENTITY=5
PRUNE_TOOLS=llm
REMOVE_UNNECESSARY_REL=true
AUTO_ENTITY_LINKING=true
VISUALIZATION_DIR=visualizations
ENABLE_VISUALIZATION=true
# API_HOST=0.0.0.0
# API_PORT=5000
# DEBUG=true
