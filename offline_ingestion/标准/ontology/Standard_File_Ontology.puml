@startuml Standard_File_Ontology
title 标准文件统一抽取本体（根 ontology.puml 的标准文件子集）

' 本文件是标准文件集合的唯一抽取模板。
' 仅保留根 ontology.puml 中适用于标准元数据、结构、条款、技术要求、
' 引用资源和制定过程的类、属性与关系；不定义任何标识/ID抽取字段。
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty methods

package "标准元数据与制定信息" <<Rectangle>> #E3F2FD {
  class "标准实体" <<Standard>> {
    - 文件编号 (文件编号)
    - 文件名称 (文件名称)
    - 发布日期 (发布日期)
    - 实施日期 (实施日期)
    - 编制目的 (编制目的)
    - 语言版本 (语言版本)
    - 标准状态 (标准状态)
    - 标准约束类型 (标准约束类型)
  }
  class "领域类别" <<DomainCategory>>
  class "国际标准分类" <<InternationalClassificationofStandard>> {
    - ICS分类代码 (ICS分类代码)
    - ICS分类名称 (ICS分类名称)
  }
  class "中国标准文献分类" <<ChineseClassificationofStandard>> {
    - CCS分类代码 (CCS分类代码)
    - CCS分类名称 (CCS分类名称)
  }
  class "相关方" <<Stakeholder>>
  class "机构" <<Organization>> {
    - 相关方名称 (相关方名称)
    - 统一信用代码 (统一信用代码)
    - 所在地 (所在地)
  }
  class "个人" <<Individual>> {
    - 姓名 (姓名)
    - 所属单位 (所属单位)
    - 联系电话 (联系电话)
    - 联系地址 (联系地址)
  }
  class "发布机构" <<Publishing Organization>>
  class "提出机构" <<Proposing Organization>>
  class "归口部门" <<CompetentDepartment>>
  class "起草单位" <<Drafting Organization>>
  class "组织实施单位" <<Implementing Organization>>
  class "征求意见单位" <<Consultation Unit>>
  class "建议方" <<Suggesting Party>>
  class "起草人" <<Drafter>>
  class "标准化对象" <<StandardizationObject>> {
    - 主题名称 (主题名称)
    - 所属行业 (所属行业)
  }
  class "制定程序" <<StandardizationProcess>> {
    - 阶段代码 (阶段代码)
    - 开始日期 (开始日期)
    - 结束日期 (结束日期)
  }
  class "预备阶段" <<Preliminary Stage>>
  class "立项阶段" <<ProposalStage>>
  class "起草阶段" <<DraftingStage>>
  class "征求意见阶段" <<ConsultationStage>>
  class "技术审查阶段" <<TechnicalReviewStage>>
  class "批准发布阶段" <<Approval and PublicationStage>>
  class "出版阶段" <<PublicationStage>>
  class "复审阶段" <<ReviewStage>>
  class "废止阶段" <<WithdrawalStage>>
}

package "标准内容与结构" <<Rectangle>> #E8F5E9 {
  class "要素" <<ContentElement>> {
    - 要素状态 (要素状态)
    - 作用范围 (作用范围)
  }
  class "规范性要素" <<Normative Element>>
  class "资料性要素" <<Informative Element>>
  class "层次" <<StructuralElement>>
  class "章" <<Section>> {
    - 章标题 (章标题)
    - 章编号 (章编号)
  }
  class "条" <<Subclause>> {
    - 条标题 (条标题)
    - 条编号 (条编号)
  }
  class "段" <<Paragraph>>
  class "列项" <<List Item>>
  class "信息单元" <<InformationUnit>> {
    - 内容描述 (内容描述)
  }
  class "条款" <<Clause>> {
    - 条款类型 (条款类型)
    - 约束类型 (约束类型)
  }
  class "附加信息" <<Additional Information>>
  class "术语" <<Terminology>> {
    - 术语标准名称 (术语标准名称)
    - 术语标准定义 (术语标准定义)
    - 同义词 (同义词)
  }
  class "信息单元表述形式" <<InformationForm>>
  class "条文" <<Provision>>
  class "表" <<Table>>
  class "图" <<Figure>>
  class "数学公式" <<Equation>>
  class "附录" <<Annex>>
  class "引用" <<Reference>>
  class "提示" <<Note>>
}

package "技术要求、活动与外部资源" <<Rectangle>> #FFF3E0 {
  class "对象" <<Object>> {
    - 对象名称 (对象名称)
    - 对象类别 (对象类别)
  }
  class "标准对象" <<Subject of Standardization>>
  class "指标对象" <<Object of Measuremen>>
  class "特性" <<Property>> {
    - 特性名称 (特性名称)
    - 特性类型 (特性类型)
    - 特性值 (特性值)
  }
  class "约束逻辑" <<Constrain>> {
    - 约束类型 (约束类型)
    - 最大值 (最大值)
    - 最小值 (最小值)
    - 阈值范围 (阈值范围)
    - 测量单位 (测量单位)
  }
  class "行动" <<ActionClass>>
  class "动作" <<Activity>>
  class "路径" <<Path>>
  class "判断条件" <<DecisionCriteria>>
  class "外部约束" <<ExternalResource>> {
    - 文件类型 (文件类型)
    - 生效时间 (生效时间)
    - 责任主体 (责任主体)
  }
  class "法规" <<Regulations>>
  class "文献" <<ReferencedDocuments>>
  class "专利" <<Patent>>
  class "公共数据库" <<PublicDatabase>>
}

' 继承关系
"国际标准分类" --|> "领域类别"
"中国标准文献分类" --|> "领域类别"
"机构" --|> "相关方"
"个人" --|> "相关方"
"发布机构" --|> "机构"
"提出机构" --|> "机构"
"归口部门" --|> "机构"
"起草单位" --|> "机构"
"组织实施单位" --|> "机构"
"征求意见单位" --|> "机构"
"建议方" --|> "机构"
"起草人" --|> "个人"
"预备阶段" --|> "制定程序"
"立项阶段" --|> "制定程序"
"起草阶段" --|> "制定程序"
"征求意见阶段" --|> "制定程序"
"技术审查阶段" --|> "制定程序"
"批准发布阶段" --|> "制定程序"
"出版阶段" --|> "制定程序"
"复审阶段" --|> "制定程序"
"废止阶段" --|> "制定程序"
"规范性要素" --|> "要素"
"资料性要素" --|> "要素"
"章" --|> "层次"
"条" --|> "层次"
"段" --|> "层次"
"列项" --|> "层次"
"条款" --|> "信息单元"
"附加信息" --|> "信息单元"
"条文" --|> "信息单元表述形式"
"表" --|> "信息单元表述形式"
"图" --|> "信息单元表述形式"
"数学公式" --|> "信息单元表述形式"
"附录" --|> "信息单元表述形式"
"引用" --|> "信息单元表述形式"
"提示" --|> "信息单元表述形式"
"标准对象" --|> "对象"
"指标对象" --|> "对象"
"动作" --|> "行动"
"路径" --|> "行动"
"判断条件" --|> "行动"
"法规" --|> "外部约束"
"文献" --|> "外部约束"
"专利" --|> "外部约束"
"公共数据库" --|> "外部约束"

' 标准元数据、制定过程与内容结构关系
"标准实体" --> "领域类别" : classifiedUnder <<classifiedUnder>>
"标准实体" --> "发布机构" : issuedBy <<issuedBy>>
"标准实体" --> "提出机构" : proposedBy <<proposedBy>>
"标准实体" --> "归口部门" : administeredBy <<administeredBy>>
"标准实体" --> "起草单位" : draftedBy <<draftedBy>>
"标准实体" --> "起草人" : draftedBy <<draftedBy>>
"标准实体" --> "标准化对象" : standardizes <<standardizes>>
"标准实体" --> "制定程序" : hasDevelopmentStage <<hasDevelopmentStage>>
"标准实体" --> "标准实体" : cites <<cites>>
"标准实体" --> "标准实体" : references <<references>>
"标准实体" --> "标准实体" : replaces <<replaces>>
"标准实体" --> "标准实体" : hasPart <<hasPart>>
"标准实体" --> "要素" : hasNormativeElement <<hasNormativeElement>>
"标准实体" --> "层次" : hasStructuralElement <<hasStructuralElement>>
"章" --> "条" : hasSubClause <<hasSubClause>>
"条" --> "条" : hasSubClause <<hasSubClause>>
"层次" --> "条款" : hasClause <<hasClause>>
"要素" --> "条款" : hasClause <<hasClause>>
"要素" --> "术语" : defines <<defines>>
"标准实体" --> "术语" : defines <<defines>>
"信息单元" --> "层次" : referencesClause <<referencesClause>>
"信息单元" --> "术语" : usesTerm <<usesTerm>>
"信息单元" --> "信息单元表述形式" : hasRepresentationForm <<hasRepresentationForm>>
"条款" --> "附加信息" : hasNote <<hasNote>>
"条款" --> "附加信息" : hasExample <<hasExample>>

' 技术要求、活动与资源关系
"对象" --> "特性" : hasCharacteristic <<hasCharacteristic>>
"特性" --> "约束逻辑" : imposesConstraint <<imposesConstraint>>
"约束逻辑" --> "特性" : constrainsCharacteristic <<constrainsCharacteristic>>
"约束逻辑" --> "对象" : constrainsObject <<constrainsObject>>
"条款" --> "对象" : involvesObject <<involvesObject>>
"条款" --> "特性" : specifiesCharacteristic <<specifiesCharacteristic>>
"信息单元" --> "行动" : describesAction <<describesAction>>
"条款" --> "外部约束" : referencesExternalResource <<referencesExternalResource>>
"标准实体" --> "外部约束" : referencesExternalResource <<referencesExternalResource>>
@enduml
