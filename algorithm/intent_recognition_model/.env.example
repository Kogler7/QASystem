# 意图识别模块环境变量（复制为 .env 后按需修改）
# 后端进程内调用时会优先加载本目录下的 .env；也可在 backend/.env 或系统环境中配置

# Milvus
MILVUS_URI=http://localhost:19530
MILVUS_CONSISTENCY_LEVEL=Strong
COLLECTION_NAME=intent_rag

# BGE-M3 模型路径（目录下需包含模型文件；不设则默认 /mnt/data3/srv/qasystem/models/bge_m3）
MODEL_PATH=/mnt/data3/srv/qasystem/models

# 意图数据与日志
DATA_DIR=../data/intent.json
LOG_PATH=

# DeepSeek API（意图识别 LLM）
DEEPSEEK_API_KEY=

# 可选
MAX_DROP_RETRIES=3
DROP_RETRY_DELAY=2
