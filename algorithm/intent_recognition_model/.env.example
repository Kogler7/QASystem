# =============================================================================
# 意图识别模块（可选独立配置）
#
# 推荐：在 backend/.env 中配置 MILVUS_*、LLM_*、NEO4J_*（与 ir_config 一致）。
# 后端会先加载仓库根 .env → backend/.env；本目录 .env 在部分入口以 override=False 加载。
#
# 仅跑意图脚本或希望与主后端配置分离时使用本文件。
# =============================================================================

MILVUS_URI=http://127.0.0.1:19530
MILVUS_CONSISTENCY_LEVEL=Strong
COLLECTION_NAME=intent_rag

MODEL_PATH=
DATA_DIR=
LOG_PATH=

DEEPSEEK_API_KEY=
LLM_BASE_URL=http://127.0.0.1:9999
LLM_MODEL=Qwen/Qwen3-8B

NEO4J_URI=neo4j://127.0.0.1:7687
# 用户名支持 NEO4J_USERNAME 或与全项目统一的 NEO4J_USER
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j2025

MAX_DROP_RETRIES=3
DROP_RETRY_DELAY=2
