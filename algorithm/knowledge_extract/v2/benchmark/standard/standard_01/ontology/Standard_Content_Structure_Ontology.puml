@startuml Standard_Content_Structure_Ontology
title 标准内容与结构独立抽取模块（源自总体本体）
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty methods

package "II. 标准内容与结构包" <<Rectangle>> #E8F5E9 {
  ' 本模块可独立抽取目录、层次、条款、术语及表图公式。
  ' Standard 仅作为文档锚点，类型和关系均复用根目录 ontology.puml。
  ' Standard 由 Standard_Metadata_Ontology.puml 唯一定义。
  class "要素" <<ContentElement>> { - 要素状态 (要素状态)\n- 作用范围 (作用范围) }
  class "规范性要素" <<Normative Element>>
  class "资料性要素" <<Informative Element>>
  class "层次" <<StructuralElement>>
  class "章" <<Section>> { - 章标题 (章标题)\n- 章编号 (章编号) }
  class "条" <<Subclause>> { - 条标题 (条标题)\n- 条编号 (条编号) }
  class "段" <<Paragraph>>
  class "列项" <<List Item>>
  class "信息单元" <<InformationUnit>> { - 唯一标识符 (唯一标识符)\n- 内容描述 (内容描述) }
  class "条款" <<Clause>> { - 条款类型 (条款类型)\n- 约束类型 (约束类型) }
  class "附加信息" <<Additional Information>>
  class "术语" <<Terminology>> { - 术语标准名称 (TermName)\n- 术语标准定义 (TermDefinition)\n- 同义词 (Synonyms) }
  class "信息单元表述形式" <<InformationForm>>
  class "条文" <<Provision>>
  class "表" <<Table>>
  class "图" <<Figure>>
  class "数学公式" <<Equation>>
  class "附录" <<Annex>>
  class "引用" <<Reference>>
  class "提示" <<Note>>

  "规范性要素" --|> "要素"
  "资料性要素" --|> "要素"
  "章" --|> "层次"
  "条" --|> "层次"
  "段" --|> "层次"
  "列项" --|> "层次"
  "条款" --|> "信息单元"
  "附加信息" --|> "信息单元"
  "条文" --|> "信息单元表述形式"
  "表" --|> "信息单元表述形式"
  "图" --|> "信息单元表述形式"
  "数学公式" --|> "信息单元表述形式"
  "附录" --|> "信息单元表述形式"
  "引用" --|> "信息单元表述形式"
  "提示" --|> "信息单元表述形式"

  "标准实体" --> "要素" : hasNormativeElement <<hasNormativeElement>>
  "标准实体" --> "层次" : hasStructuralElement <<hasStructuralElement>>
  "章" --> "条" : hasSubClause <<hasSubClause>>
  "条" --> "条" : hasSubClause <<hasSubClause>>
  "层次" --> "条款" : hasClause <<hasClause>>
  "要素" --> "条款" : hasClause <<hasClause>>
  "要素" --> "术语" : defines <<defines>>
  "信息单元" --> "层次" : referencesClause <<referencesClause>>
  "信息单元" --> "信息单元表述形式" : hasRepresentationForm <<hasRepresentationForm>>
  "信息单元" --> "术语" : usesTerm <<usesTerm>>
  "条款" --> "附加信息" : hasNote <<hasNote>>
  "条款" --> "附加信息" : hasExample <<hasExample>>
}
@enduml
