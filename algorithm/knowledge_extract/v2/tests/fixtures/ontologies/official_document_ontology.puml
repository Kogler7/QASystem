@startuml
' Phase1 Step1 基准集本体：公文元模型子集
' 依据 uml/公文智能问答场景-元模型.md，标识与 Phase1 v3 文档 §12 一致。

class "公文管理单元" as OfficialDocument <<OfficialDocument>> {
  + 收文号 (receiveNumber): String // 公文接收编号
  + 文件标题 (documentTitle): String // 公文标题
  + 来文单位 (sourceOrganization): String // 公文来源单位
  + 来文字号 (sourceDocumentNumber): String // 公文原始编号
  + 联系电话 (contactPhone): String // 联系方式
  + 密级 (classification): String // 保密级别
  + 缓急 (urgency): String // 紧急程度
  + 收文日期 (receiveDate): Date // 接收日期
  + 收文部门 (receiveDepartment): String // 接收部门
  + 主办部门 (hostDepartment): String // 主办部门
  + 文件备注 (remarks): String // 备注信息
  + 主送 (mainRecipients): String // 主送单位列表
  + 抄送 (ccRecipients): String // 抄送单位列表
  + 拟办意见 (suggestion): String // 拟办建议
  + 领导批示 (leaderInstruction): String // 领导指示
}

class "公文结构单元" as DocumentUnit <<DocumentUnit>> {
  + 单元标识 (unitId): String // 结构单元标识
  + 单元类型 (unitType): String // 章、节、条、款、项、段落、附件
  + 单元标题 (unitTitle): String // 单元标题
  + 顺序号 (unitOrder): Integer // 顺序号
  + 原文内容 (originalText): String // 原文内容
  + 原文位置 (location): String // 原文位置
}

class "运行主体" as OperationalAgent <<OperationalAgent>> {
  + 主体标识 (agentId): String // 主体标识
  + 主体名称 (agentName): String // 主体名称
  + 主体类型 (agentType): String // 组织、部门、岗位、角色、外部机构
  + 组织层级 (organizationLevel): String // 集团、子公司、部门、项目组
  + 职责 (responsibility): String // 职责描述
}

class "业务对象" as OperationalObject <<OperationalObject>> {
  + 对象标识 (objectId): String // 对象标识
  + 对象名称 (objectName): String // 对象名称
  + 对象类型 (objectType): String // 平台、系统、数据、模型、项目、制度、场景
  + 所属领域 (domain): String // 对象描述
  + 对象描述 (description): String // 所属业务领域
}

class "任务活动" as OperationalActivity <<OperationalActivity>> {
  + 活动标识 (activityId): String // 活动标识
  + 活动名称 (activityName): String // 活动名称
  + 活动类型 (activityType): String // 建设、管理、评估、报送、监督、实施、试点等
  + 动作词 (actionVerb): String // 动作词，如建设、完善、推进、加强、组织
  + 活动描述 (description): String // 活动描述
  + 优先级 (priority): String // 重点、一般、长期、紧急
  + 预期结果 (expectedResult): String // 预期结果
}

class "运行信息" as OperationalInformation <<OperationalInformation>> {
  + 信息标识 (informationId): String // 信息对象标识
  + 信息名称 (informationName): String // 信息名称
  + 信息类型 (informationType): String // 术语、指标、报告、材料、数据、附件、依据
  + 定义 (definition): String // 定义说明
  + 来源文本 (sourceText): String // 来源原文
}

class "运行交互" as OperationalExchange <<OperationalExchange>> {
  + 交互标识 (exchangeId): String // 交互标识
  + 交互类型 (exchangeType): String // 报送、审批、反馈、协同、监督、通知、备案
  + 交互描述 (description): String // 交互描述
}

class "约束条件" as OperationalConstraint <<OperationalConstraint>> {
  + 约束标识 (constraintId): String // 约束标识
  + 约束名称 (constraintName): String // 约束名称
  + 约束类型 (constraintType): String // 时间约束、权限约束、安全约束、流程约束、质量约束、合规约束
  + 约束原文 (constraintText): String // 约束原文
  + 强制程度 (mandatoryLevel): String // 必须、应当、原则上、鼓励、禁止
  + 校验规则 (validationRule): String // 校验规则
}

OfficialDocument "1" --> "1..*" DocumentUnit : HAS_PART // 包含结构单元
OfficialDocument "1" --> "1..*" OperationalAgent : ISSUED_BY // 发布主体
OfficialDocument "1" --> "0..*" OperationalAgent : APPLIES_TO // 适用主体
OfficialDocument "1" --> "0..*" OperationalObject : CONCERNS_OBJECT // 涉及对象
OfficialDocument "1" --> "0..*" OperationalActivity : REQUIRES_ACTIVITY // 提出任务
OfficialDocument "1" --> "0..*" OperationalInformation : HAS_KEY_INFORMATION // 关键信息
OfficialDocument "1" --> "0..*" OperationalInformation : DEFINES // 定义信息
OfficialDocument "1" --> "0..*" OperationalExchange : HAS_EXCHANGE // 规定交互
OfficialDocument "1" --> "0..*" OperationalConstraint : HAS_CONSTRAINT // 规定约束
OperationalAgent "0..*" --> "1..*" DocumentUnit : EVIDENCED_BY // 原文依据
OperationalObject "0..*" --> "1..*" DocumentUnit : EVIDENCED_BY // 原文依据
OperationalActivity "1" --> "0..*" OperationalObject : ACTS_ON // 作用对象
OperationalActivity "1" --> "0..*" OperationalAgent : PERFORMED_BY // 执行主体
OperationalActivity "0..*" --> "0..*" OperationalActivity : PRECEDES // 先后关系
OperationalActivity "1" --> "0..*" OperationalInformation : USES_INFORMATION // 使用信息
OperationalActivity "1" --> "0..*" OperationalInformation : PRODUCES // 产生信息
OperationalActivity "0..*" --> "1..*" DocumentUnit : EVIDENCED_BY // 原文依据
OperationalInformation "0..*" --> "0..*" OperationalInformation : RELATED_TO // 关联或同义
OperationalInformation "0..*" --> "1..*" DocumentUnit : EVIDENCED_BY // 原文依据
OperationalExchange "1" --> "1" OperationalAgent : sourceAgent // 发起主体
OperationalExchange "1" --> "1" OperationalAgent : targetAgent // 接收主体
OperationalExchange "1" --> "0..*" OperationalInformation : EXCHANGES_INFORMATION // 交互信息
OperationalExchange "1" --> "0..*" OperationalActivity : SUPPORTS_ACTIVITY // 支撑任务
OperationalExchange "0..*" --> "1..*" DocumentUnit : EVIDENCED_BY // 原文依据
OperationalConstraint "1" --> "0..*" OperationalActivity : CONSTRAINS_ACTIVITY // 约束任务
OperationalConstraint "1" --> "0..*" OperationalAgent : CONSTRAINS_AGENT // 约束主体
OperationalConstraint "1" --> "0..*" OperationalObject : CONSTRAINS_OBJECT // 约束对象
OperationalConstraint "0..*" --> "1..*" DocumentUnit : EVIDENCED_BY // 原文依据

' @identity OfficialDocument: documentTitle
' @identity DocumentUnit: unitId
' @identity OperationalAgent: agentName
' @identity OperationalObject: objectName
' @identity OperationalActivity: activityName
' @identity OperationalInformation: informationName
' @identity OperationalExchange: exchangeId
' @identity OperationalConstraint: constraintName
@enduml
