@startuml
' Phase1 Step1 基准集本体：标准本体子集
' 依据 docs/method/Phase1_Knowledge_Extraction_Harness_Design_v3.md 与 uml/标准本体模型(1).md
' 标识均为运行时 OntologySchema 可解析的稳定标识，禁止额外发明 schema。

class "标准实体" as Standard <<Standard>> {
  + 文件编号 (standardNumber): String // 标准编号
  + 文件名称 (documentName): String // 标准完整名称
  + 发布日期 (issuedDate): Date // 发布日期
  + 实施日期 (effectiveDate): Date // 实施日期
  + 标准状态 (status): String // 草案/现行/废止/修订中
  + 编制目的 (purpose): String // 标准的制定目标
  + 语言版本 (languageVersion): String // 中文版本/英文版本
  + 约束类型 (constraintType): String // 强制性/推荐性
}

class "标准化对象" as StandardizationObject <<StandardizationObject>> {
  + 主题名称 (subjectName): String // 被标准化事物的主题名称
  + 所属行业 (industrialSector): String // 行业分类
}

class "相关方" as Stakeholder <<Stakeholder>> {
}
class "机构" as Organization <<Organization>> {
  + 名称 (orgName): String // 机构法定或通用名称
}
class "个人" as Individual <<Individual>> {
  + 姓名 (personName): String // 个人法定姓名
}
Organization --|> Stakeholder
Individual --|> Stakeholder

class "领域类别" as DomainCategory <<DomainCategory>> {
}
class "国际标准分类" as InternationalClassificationStandard <<InternationalClassificationStandard>> {
  + ICS分类代码 (ICS_code): String // ICS代码
  + ICS分类名称 (ICS_name): String // ICS名称
}
class "中国标准文献分类" as ChineseClassificationofStandard <<ChineseClassificationofStandard>> {
  + CCS分类代码 (CCS_code): String // CCS代码
  + CCS分类名称 (CCS_name): String // CCS名称
}
InternationalClassificationStandard --|> DomainCategory
ChineseClassificationofStandard --|> DomainCategory

class "层次" as StructuralElement <<StructuralElement>> {
  + 章编号 (sectionNumber): String // 章的层级编号
  + 章标题 (sectionTitle): String // 章的标题
  + 条编号 (clauseNumber): String // 条的层级编号
  + 条标题 (clauseTitle): String // 有标题条的标题
}
class "章" as Section <<Section>> {
}
class "条" as Clause <<Clause>> {
  + 唯一标识符 (uniqueIdentifier): String // 信息单元唯一编码
  + 内容描述 (contentDescription): String // 条款正文描述
  + 条款类型 (clauseType): String // 要求型/推荐型/指示型/允许型/陈述型
  + 约束类型 (constraintType): String // 强制/推荐/描述
  + 条编号 (clauseNumber): String // 条的层级编号
  + 条标题 (clauseTitle): String // 条的标题
}
Section --|> StructuralElement
Clause --|> StructuralElement

class "信息单元" as InformationUnit <<InformationUnit>> {
  + 唯一标识符 (uniqueIdentifier): String // 信息单元唯一编码
  + 内容描述 (contentDescription): String // 内容描述
}
Clause --|> InformationUnit

class "对象" as Object <<Object>> {
  + 对象名称 (objectName): String // 对象名称
  + 对象类别 (objectCategory): String // 对象类别，如设备、材料
}
class "特性" as Property <<Property>> {
  + 特性名称 (propertyName): String // 特性名称
  + 特性值 (propertyValue): String // 具体值
  + 特性类型 (propertyType): String // 描述型/能力型/约束型
}
class "约束逻辑" as Constraint <<Constraint>> {
  + 约束类型 (constraintType): String // 数值区间/枚举值/逻辑表达式
  + 最大值 (maxValue): Float // 最大允许值
  + 最小值 (minValue): Float // 最小允许值
  + 阈值范围 (thresholdRange): String // 最小值-最大值
  + 测量单位 (unit): String // 单位，如 V、W、℃
  + 允许值 (allowedValue): String[] // [Ontology Extension] 枚举约束的允许项数组（标准本体模型.md 未声明，源自人工检查抽取结果）
  + 符合依据 (conformsTo): String // [Ontology Extension] 符合性约束的依据（标准本体模型.md 未声明，源自人工检查抽取结果）
  + 比较基准 (comparedTo): String // [Ontology Extension] 数值/相对值约束的比较基准（标准本体模型.md 未声明，源自人工检查抽取结果）
  + 约束目标 (constraintTarget): String // [Ontology Extension] 相对值约束的受约束对象（标准本体模型.md 未声明，源自人工检查抽取结果）
}
class "行动" as ActionClass <<ActionClass>> {
  + 动作名称 (actionName): String // 动作名称
  + 动作描述 (actionDescription): String // 动作描述
}
class "外部资源" as ExternalResource <<ExternalResource>> {
  + 文件类型 (fileType): String // 法规/专利/文献/公共数据库
  + 生效时间 (effectiveTime): Date // 生效日期
  + 责任主体 (responsibleParty): String // 责任主体
}
class "制定程序" as StandardizationProcess <<StandardizationProcess>> {
  + 阶段代码 (stageCode): String // 阶段唯一标识
}
class "术语" as Terminology <<Terminology>> {
  + 术语标准名称 (TermName): String // 术语的标准名称
  + 术语标准定义 (TermDefinition): String // 术语的标准业务定义
  + 同义词 (Synonyms): String[] // 简称、别称或口语化表达
}

Standard "1" --> "0..*" StructuralElement : hasStructuralElement // 包含层次
Section "1" --> "0..*" Clause : hasSubClause // 章包含条
Clause "1" --> "0..*" Clause : hasSubClause // 条包含子条
StructuralElement "1" --> "0..*" Clause : hasClause // 包含条款
Standard "1" --> "0..*" StandardizationObject : standardizes // 标准化对象
Standard "1" --> "0..*" Organization : issuedBy // 发布机构
Standard "1" --> "0..*" Standard : cites // 引用标准
Standard "1" --> "0..*" Terminology : defines // 界定术语
Clause "1" --> "0..*" Terminology : usesTerm // 提及术语
Clause "1" --> "0..*" Object : involvesObject // 涉及对象
Clause "1" --> "0..*" Property : specifiesCharacteristic // 规定特性
Object "1" --> "0..*" Property : hasCharacteristic // 具有特性
Clause "1" --> "0..*" Constraint : imposesConstraint // 施加约束
Property "1" --> "0..*" Constraint : imposesConstraint // 施加约束
Constraint "1" --> "0..*" Property : constrainsCharacteristic // 约束特性
Constraint "1" --> "0..*" Object : constrainsObject // 约束对象
InformationUnit "1" --> "0..*" ActionClass : describesAction // 描述行动
InformationUnit "1" --> "0..*" StructuralElement : referencesClause // 引用章条
Standard "1" --> "0..*" ExternalResource : referencesExternalResource // 引用外部资源

' @identity Standard: standardNumber
' @identity Section: sectionNumber
' @identity Clause: clauseNumber
' @identity StandardizationObject: subjectName
' @identity Organization: orgName
' @identity Object: objectName
' @identity Property: propertyName
' @identity ActionClass: actionName
' @identity Terminology: TermName
@enduml
