# Neo4j 配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j2025

# LLM 配置
LLM_TYPE=glm-4.7
LLM_API_KEY=your_api_key_here
MAX_LENGTH=256
TEMPERATURE_EXPLORATION=0.4
TEMPERATURE_REASONING=0.0

# ToG 搜索配置
WIDTH=3
DEPTH=3
NUM_RETAIN_ENTITY=5
PRUNE_TOOLS=llm
REMOVE_UNNECESSARY_REL=true
AUTO_ENTITY_LINKING=true

# 可视化配置
VISUALIZATION_DIR=visualizations
ENABLE_VISUALIZATION=true

# 服务配置
API_HOST=0.0.0.0
API_PORT=5000
DEBUG=true
