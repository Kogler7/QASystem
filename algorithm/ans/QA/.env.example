# =============================================================================
# QA 模块 .env（仅当你单独在本目录运行脚本/服务时使用）
#
# 通过后端 API（docker compose / uvicorn）使用时：
# - 推荐统一在仓库根 .env（部署）或 backend/.env（本机）配置同名变量；
# - 本文件仅作本目录运行补充，默认不覆盖已存在环境变量。
# =============================================================================

NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# 历史变量，推荐优先使用统一变量 LLM_MODEL（后端会自动回退）
LLM_TYPE=
LLM_API_KEY=

MAX_LENGTH=256
TEMPERATURE_EXPLORATION=0.4
TEMPERATURE_REASONING=0.0

WIDTH=3
DEPTH=3
NUM_RETAIN_ENTITY=5
PRUNE_TOOLS=llm
REMOVE_UNNECESSARY_REL=true
AUTO_ENTITY_LINKING=true

VISUALIZATION_DIR=visualizations
ENABLE_VISUALIZATION=true

API_HOST=0.0.0.0
API_PORT=5000
DEBUG=true
