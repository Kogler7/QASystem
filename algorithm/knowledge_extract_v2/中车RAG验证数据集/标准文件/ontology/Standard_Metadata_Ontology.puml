@startuml Standard_Metadata_Ontology
title 标准元数据与制定信息独立抽取模块（源自总体本体）
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty methods

package "I. 标准元数据与制定信息包" <<Rectangle>> #E3F2FD {
  ' 本模块可独立抽取标准标识、分类、发布制定主体、标准化对象与制定阶段。
  class "标准实体" <<Standard>> {
    - 文件编号 (文件编号)
    - 文件名称 (文件名称)
    - 发布日期 (发布日期)
    - 实施日期 (实施日期)
    - 编制目的 (编制目的)
    - 语言版本 (语言版本)
    - 标准状态 (标准状态)
    - 标准约束类型 (约束类型)
  }
  class "领域类别" <<DomainCategory>>
  class "国际标准分类" <<InternationalClassificationofStandard>> { - ICS分类代码 (ICS分类代码)\n- ICS分类名称 (ICS分类名称) }
  class "中国标准文献分类" <<ChineseClassificationofStandard>> { - CCS分类代码 (CCS分类代码)\n- CCS分类名称 (CCS分类名称) }
  class "机构" <<Organization>> { - 相关方名称 (名称)\n- 统一信用代码 (统一信用代码)\n- 所在地 (所在地) }
  class "发布机构" <<Publishing Organization>>
  class "提出机构" <<Proposing Organization>>
  class "归口部门" <<CompetentDepartment>>
  class "起草单位" <<Drafting Organization>>
  class "组织实施单位" <<Implementing Organization>>
  class "个人" <<Individual>> { - 姓名 (姓名)\n- 所属单位 (所属单位)\n- 联系电话 (联系电话)\n- 联系地址 (联系地址) }
  class "起草人" <<Drafter>>
  class "标准化对象" <<StandardizationObject>> { - 主题名称 (主题名称)\n- 所属行业 (所属行业) }
  class "制定程序" <<StandardizationProcess>> { - 阶段代码 (阶段代码)\n- 开始日期 (开始日期)\n- 结束日期 (结束日期) }
  class "批准发布阶段" <<Approval and PublicationStage>>

  "国际标准分类" --|> "领域类别"
  "中国标准文献分类" --|> "领域类别"
  "发布机构" --|> "机构"
  "提出机构" --|> "机构"
  "归口部门" --|> "机构"
  "起草单位" --|> "机构"
  "组织实施单位" --|> "机构"
  "起草人" --|> "个人"
  "批准发布阶段" --|> "制定程序"

  "标准实体" --> "领域类别" : classifiedUnder <<classifiedUnder>>
  "标准实体" --> "发布机构" : issuedBy <<issuedBy>>
  "标准实体" --> "提出机构" : proposedBy <<proposedBy>>
  "标准实体" --> "归口部门" : administeredBy <<administeredBy>>
  "标准实体" --> "起草单位" : draftedBy <<draftedBy>>
  "标准实体" --> "起草人" : draftedBy <<draftedBy>>
  "标准实体" --> "标准化对象" : standardizes <<standardizes>>
  "标准实体" --> "制定程序" : hasDevelopmentStage <<hasDevelopmentStage>>
  "标准实体" --> "标准实体" : cites <<cites>>
  "标准实体" --> "标准实体" : replaces <<replaces>>
}
@enduml
