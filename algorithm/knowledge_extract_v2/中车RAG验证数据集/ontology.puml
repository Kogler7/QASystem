@startuml ontology
' 设置全局样式
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 50

' ==========================================
' 1. 类定义与属性 (Class Definitions & Attributes)
' ==========================================

class "行动" <<ActionClass>> {
  类定义：描述可执行模块的程序要素。包含动作、路径、判断条件子类
}

class "动作" <<Activity>> {
}

class "附加信息" <<Additional Information>> {
}

class "附录" <<Annex>> {
}

class "批准发布阶段" <<Approval and PublicationStage>> {
}

class "业务对象" <<BusinessObject>> {
  - 块类型 (BlockType) //业务对象的块类型，例如 "业务实体"。
  - 块ID (BlockID) //业务对象的唯一标识符，例如 "PARENT-BIM-001"。
  - 业务对象名称 (BusinessObjectName) //业务对象的标准名称，例如 "招采项目"。
  - 业务对象属性列表 (BusinessAttributes) //业务对象包含的属性集合，记录属性名称、数据类型及字段说明，例如 bidcot: bigint / 标段数量。
  - 关联数据表 (RelatedDataTable) //业务对象关联的数据表名称及说明，例如 "电子采购信息汇总表(dws_dzcg_bidsum)"。
  - 相关指标 (RelatedMetrics) //该业务对象支撑或关联的指标集合，例如 "采购标段数量(ICM-1.1)"。
  - 业务含义与流程 (BusinessMeaningAndProcess) //业务对象所承载的业务含义、业务流程及业务上下文描述。
  - 业务对象所关联干系人 (Stakeholders) //与该业务对象相关的业务角色、部门或使用者，例如采购管理部门、需求部门。
}

class "中国标准文献分类" <<ChineseClassificationofStandard>> {
  - CCS分类代码 (CCS分类代码) //中国标准文献分类(CCS)代码。值域为枚举类型:根据中国标准文献分类给定的分类代码填写。
  - CCS分类名称 (CCS分类名称) //中国标准文献分类(CCS)名称。值域为枚举类型:根据中国标准文献分类给定的分类名称填写。
}

note right of 中国标准文献分类
  类定义：基于中国标准文献分类(CCS)的标准分类体系
end note

class "条款" <<Clause>> {
  - 条款类型 (条款类型) //标识条款类型(如 "要求型"、"推荐型") 注:值域为枚举类型:要求型、推荐型、指示型、允许型、陈述型。
  - 约束类型 (约束类型) //时间约束、权限约束、安全约束、流程约束、质量约束、合规约束
}

class "归口部门" <<CompetentDepartment>> {
}

class "关注点" <<Concern>> {
  - 关注点标识 (关注点标识) //关注点标识
  - 关注点名称 (关注点名称) //关注点名称
  - 关注点类型 (关注点类型) //关注点类型
  - 关注点描述 (关注点描述) //关注点描述
}

note right of 关注点
  类定义：Concern is a matter of importance to a stakeholder.
end note

class "约束逻辑" <<Constrain>> {
  - 约束类型 (约束类型) //时间约束、权限约束、安全约束、流程约束、质量约束、合规约束
  - 最大值 (最大值) //数值约束的最大允许值(如 "100W" )
  - 最小值 (最小值) //数值约束的最小允许值(如 "80W" )
  - 阈值范围 (阈值范围) //数值的有效范围(如 "80-100W" )。 (格式:最小值-最大值)
  - 测量单位 (测量单位) //数值的单位(如 "V" "W" ) 值域为枚举类型:V、W、℃等。
}

note right of 约束逻辑
  类定义：描述条款对对象特性施加的限定条件,支持数值范围、枚举值、逻辑表达式等约束形式
end note

class "征求意见单位" <<Consultation Unit>> {
}

class "征求意见阶段" <<ConsultationStage>> {
}

class "要素" <<ContentElement>> {
  - 要素状态 (要素状态) //标识要素的存在状态。 值域为枚举类型:必备、可选。
  - 作用范围 (作用范围) //规定要素的适用范围
}

note right of 要素
  类定义：标准内容的作用性要素分类
end note

class "数据本体模型" <<DataModel>> {
  - 块类型 (BlockType) //数据模型块类型，例如 "单表定义"。
  - 数据表ID (TableID) //数据表唯一标识，例如 "T01"。
  - 数据表名称 (TableName) //数据表英文名称，例如 dws_dzcg_bidsum。
  - 数据表中文名称 (TableChineseName) //数据表中文名称，例如 "电子采购信息汇总表"。
  - 表类型 (TableType) //数据表类型，例如事实汇总表、维度表、明细表。
  - 数据主题 (DataSubject) //数据表所属的数据主题，例如电子采购汇总数据。
  - 适配指标字段 (AdaptedMetricCodes) //该数据表可支撑的指标编码集合，例如 ICM-1.1、ICM-1.2。
  - 表用途 (TableUsage) //数据表支撑的业务用途或指标计算场景说明。
  - 逻辑主键 (LogicalPrimaryKey) //数据表的逻辑主键或业务唯一标识字段，例如 id。
  - 常用统计粒度 (CommonStatisticalGrain) //该表常用于统计聚合的粒度字段，例如 fk_period_1、fk_org_1。
  - 常用过滤维度 (CommonFilterDimensions) //该表常用于 where 过滤的字段，例如 fk_period_1、fk_procuretype_1、supplier_name。
  - 常用分组维度 (CommonGroupDimensions) //该表常用于 group by 分组统计的字段，例如 fk_period_1、fk_org_1。
  - 字段定义 (FieldDefinitions) //数据表字段集合，记录字段名、数据类型、字段说明及字典值，例如 fk_procuretype_1: varchar / 采购分类，物资=1，服务=2，工程=3，设备=4。
}

class "判断条件" <<DecisionCriteria>> {
}

class "公文结构单元" <<DocumentUnit>> {
  - 单元标识 (单元标识) //结构单元标识
  - 单元标题 (单元标题) //单元标题
  - 单元类型 (单元类型) //章、节、条、款、项、段落、附件
  - 原文位置 (原文位置) //原文位置
  - 原文内容 (原文内容) //原文内容
  - 顺序号 (顺序号) //顺序号
}

note right of 公文结构单元
  类定义：公文内部的章节、条、款、项、附件说明等结构单元，是公文内容解析和证据追溯的基本载体。
end note

class "领域类别" <<DomainCategory>> {
}

note right of 领域类别
  类定义：按标准化领域划分的标准分类，包括国际标准分类、中国标准文献分类子类
end note

class "起草人" <<Drafter>> {
}

note right of 起草人
  类定义：本标准由某人起草
end note

class "起草单位" <<Drafting Organization>> {
}

note right of 起草单位
  类定义：表示标准由某起草单位起草
end note

class "起草阶段" <<DraftingStage>> {
}

class "数学公式" <<Equation>> {
}

class "外部约束" <<ExternalResource>> {
  - 文件类型 (文件类型) //外部文件的分类(如 "法规"、"专利" ) 注:值域为枚举类型:法规、专利、文献、公共数据库。
  - 生效时间 (生效时间) //文件的生效日期。 (格式:YYYY-MM-DD)
  - 责任主体 (责任主体) //文件的责任主体(如 "国家标准化管理委员会" )
}

note right of 外部约束
  类定义：与标准有关的其他文件资源。包含法规、专利、文献、公共数据库子类
end note

class "图" <<Figure>> {
}

class "组织实施单位" <<Implementing Organization>> {
}

class "个人" <<Individual>> {
  - 姓名 (姓名) //个人法定姓名
  - 所属单位 (所属单位) //个人所属的机构或组织名称
  - 联系电话 (联系电话) //联系方式，例如：010-51862178
  - 联系地址 (联系地址)
}

note right of 个人
  类定义：表示参与标准化活动的个人实体，包括以下子类：起草人、评审人
end note

class "信息单元表述形式" <<InformationForm>> {
}

note right of 信息单元表述形式
  类定义：信息单元的表现形式分类。包括条文、图、表、数学公式、附录、引用、提示等子类。
end note

class "信息单元" <<InformationUnit>> {
  - 唯一标识符 (唯一标识符) //信息单元的唯一编码(如 "IU-001" )
  - 内容描述 (内容描述) //信息单元的详细描述文本
}

note right of 信息单元
  类定义：经过有意义的模块化处理且在句法和语义上自包含的信息片段。包括条款、附加信息（示例、注、脚注、清单、列表等）子类
end note

class "资料性要素" <<Informative Element>> {
  - 要素状态 (要素状态) //标识要素的存在状态。 值域为枚举类型:必备、可选。
  - 作用范围 (作用范围) //规定要素的适用范围
}

note right of 资料性要素
  类定义：包括规范性引用文件、参考文献、索引
end note

class "国际标准分类" <<InternationalClassificationofStandard>> {
  - ICS分类代码 (ICS分类代码) //国际标准分类(ICS)代码。 值域为枚举类型:根据国际标准分类给定的分类代码填写。
  - ICS分类名称 (ICS分类名称) //国际标准分类(ICS)名称。 值域为枚举类型:根据国际标准分类给定的分类名称填写。
}

note right of 国际标准分类
  类定义：基于国际标准分类法(ICS)的标准分类体系
end note

class "列项" <<List Item>> {
}

class "指标" <<Metric>> {
  - 指标标准编码 (MetricCode) //指标的唯一标准编码，例如 "ICM-1.1"。
  - 指标标准名称 (MetricName) //指标的标准名称，例如 "采购标段数量"。
  - 一级分类 (L1) //指标所属一级业务分类，枚举值为：产业链供应链管理。
  - 二级分类 (L2) //指标所属二级业务分类，枚举值为：采购管理域、供应商管理域、供应链管理域、物流管理域。
  - 三级分类 (L3) //指标所属三级业务分类，枚举值为：招采过程管理、合同签约管理、集中采购管理、供应商管理、库存管理、物流运输管理、风险监测管理、废旧处置管理、协同及金融管理。
  - 指标类别 (MetricCategory) //指标类别，例如原子指标、衍生指标。
  - 指标分类 (MetricType) //指标分类，例如业务运行指标、管理分析指标。
  - 指标定义 (MetricDefinition) //指标的标准业务定义，用于说明指标统计对象、统计范围和统计含义。
  - 计量单位 (Unit) //指标统计结果的计量单位，例如 "万个" "万元" "%"。
  - 维度 (Dimensions) //指标支持的统计维度，例如时间、组织、采购分类、标段状态。
  - 数仓结果所在表名 (DataWarehouseTable) //指标计算或查询所依赖的数仓表名，例如 dws_dzcg_bidsum。
  - 来源字段 (SourceField) //指标计算所使用的数据表字段，例如 bidcot、winbid_cot。
  - 逻辑补充 (LogicSupplement) //指标查询规则、过滤条件、参数替换、SQL选择逻辑等补充说明。
  - SQL模板 (SQLTemplate) //指标对应的标准SQL或参数化SQL模板，用于生成最终查询语句。
}

class "规范性要素" <<Normative Element>> {
  - 要素状态 (要素状态) //标识要素的存在状态。 值域为枚举类型:必备、可选。
  - 作用范围 (作用范围) //规定要素的适用范围
}

note right of 规范性要素
  类定义：包括范围、术语和定义、符号和缩略语、核心技术要素、其他技术要素
end note

class "提示" <<Note>> {
}

class "对象" <<Object>> {
  - 对象名称 (对象名称) //对象的名称(如 "锂电池"、"电机控制器" )
  - 对象类别 (对象类别) //标识对象类别(如 "设备"、"材料" )
}

note right of 对象
  类定义：条款中涉及的实体对象。包含标准对象、指标对象子类
end note

class "指标对象" <<Object of Measuremen>> {
  - 对象名称 (对象名称) //对象的名称(如 "锂电池" "电机控制器" )
  - 对象类别 (对象类别) //标识对象类别(如 "设备" "材料" )
}

class "公文管理单元" <<OfficialDocument>> {
  - 领导批示 (领导批示) //领导指示，例如：请相关部门阅办
  - 联系电话 (联系电话) //联系方式，例如：010-51862178
  - 缓急 (缓急) //紧急程度，例如：特急/急/平急
  - 来文字号 (来文字号) //公文原始编号，例如：中车集团办运营〔2026〕17号
  - 来文单位 (来文单位) //公文来源单位，例如：中国中车集团有限公司
  - 文件标题 (文件标题) //公文标题，例如：关于印发中国中车2026年数智转型工作要点的通知 [约束：管理单元数量约束 (CUSTOM_EXPRESSION，一篇公文只能抽取出一个公文管理单元) ]
  - 文件备注 (文件备注) //备注信息
  - 收文部门 (收文部门) //接收部门，例如：综合管理部
  - 收文日期 (收文日期) //接收日期，例如：2026-03-18
  - 收文号 (收文号) //公文接收编号，例如：信息公司收〔2026〕176号
  - 拟办意见 (拟办意见) //拟办建议，例如：请领导阅批
  - 抄送 (抄送) //抄送单位列表，例如：相关部门
  - 密级 (密级) //保密级别，例如：绝密/机密/秘密/内部
  - 主送 (主送) //主送单位列表，例如：各部门/各单位
  - 主办部门 (主办部门) //主办部门，例如：信息公司技术中心
}

note right of 公文管理单元
  类定义：公文的管理信息，一份公文只抽取出一个公文管理单元
end note

class "任务活动" <<OperationalActivity>> {
  - 活动名称 (活动名称) //活动名称
  - 活动描述 (活动描述) //活动描述
  - 活动标识 (活动标识) //活动标识
  - 活动类型 (活动类型) //建设、管理、评估、报送、监督、实施、试点等
  - 动作词 (动作词) //动作词，如建设、完善、推进、加强、组织
  - 预期结果 (预期结果) //预期结果
  - 优先级 (优先级) //重点、一般、长期、紧急
}

note right of 任务活动
  类定义：公文中提出的需要执行的任务、行动、建设内容、管理动作或工作安排。 示例： 建设人工智能平台、完善算法治理机制、开展试点应用、加强数据安全管理、建立模型评估机制。
end note

class "运行主体" <<OperationalAgent>> {
  - 主体名称 (主体名称) //主体名称
  - 主体标识 (主体标识) //主体标识
  - 主体类型 (主体类型) //组织、部门、岗位、角色、外部机构
  - 组织层级 (组织层级) //集团、子公司、部门、项目组
  - 职责 (职责) //职责描述
}

note right of 运行主体
  类定义：公文中出现的组织、部门、岗位、角色、单位、责任主体、协同主体等。
end note

class "运行约束条件" <<OperationalConstraint>> {
  - 强制程度 (强制程度) //必须、应当、原则上、鼓励、禁止
  - 约束原文 (约束原文) //约束原文
  - 约束名称 (约束名称) //约束名称
  - 约束标识 (约束标识) //约束标识
  - 约束类型 (约束类型) //时间约束、权限约束、安全约束、流程约束、质量约束、合规约束
  - 校验规则 (校验规则) //校验规则
}

note right of 运行约束条件
  类定义：公文中规定的必须遵守的规则、限制、条件、标准、时间要求、合规要求和质量要求。 示例： 按期完成、不得违反数据安全要求、应符合集团统一技术规范、必须报送备案、原则上不得重复建设。
end note

class "运行交互" <<OperationalExchange>> {
  - 交互类型 (交互类型) //报送、审批、反馈、协同、监督、通知、备案
  - 交互标识 (交互标识) //交互标识
  - 交互描述 (交互描述) //交互描述
}

note right of 运行交互
  类定义：公文中表达的主体之间、任务之间、信息之间的传递、协同、报送、审批、反馈、监督等关系。 示例： 子公司向集团报送试点进展；业务部门配合信息化部门开展平台建设；牵头部门组织相关单位完成评估。
end note

class "运行信息" <<OperationalInformation>> {
  - 信息标识 (信息标识) //信息对象标识
  - 信息名称 (信息名称) //信息名称
  - 信息类型 (信息类型) //术语、指标、报告、材料、数据、附件、依据
  - 定义 (定义) //定义说明
  - 来源文本 (来源文本) //来源原文
