    {
      "type": "DocumentUnit",
      "name": "通知正文",
      "properties": {
        "单元标题": "关于印发《中国中车智能工厂梯度培育实施方案（2025—2030年）》的通知",
        "单元类型": "正文",
        "原文位置": "《关于印发《中国中车智能工厂梯度培育实施方案（2025—2030年）》的通知》正文",
        "原文内容": "根据工业和信息化部《关于做好2025年度智能工厂梯度培育有关工作的函》（工通装函〔2025〕97号）要求，集团公司研究制定了《中国中车智能工厂梯度培育实施方案（2025—2030年）》，已经集团公司2025年第12次总经理办公会审议通过，现予以印发，请认真贯彻执行。方案围绕1个中心任务、1套评估体系、4个层级梯度体系、6个方面建设任务，推进基础级、先进级、卓越级和领航级智能工厂梯度培育。",
        "顺序号": ""
      }
    },
