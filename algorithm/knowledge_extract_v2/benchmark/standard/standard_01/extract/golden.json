    {"type":"Terminology","name":"高能量电池","properties":{"术语标准名称":"高能量电池","术语标准定义":"室温下最大允许输出电功率与3I3倍率放电能量比值低于10的电池。","同义词":"high energy battery"}},
    {"type":"Terminology","name":"高功率电池","properties":{"术语标准名称":"高功率电池","术语标准定义":"室温下最大允许输出电功率与1I1倍率放电能量比值不低于10的电池。","同义词":"high power battery"}},
    {"type":"Terminology","name":"额定容量","properties":{"术语标准名称":"额定容量","术语标准定义":"完全充电后以规定放电电流测得并由制造商申明的容量值。","同义词":"rated capacity"}},
    {"type":"Terminology","name":"额定能量","properties":{"术语标准名称":"额定能量","术语标准定义":"完全充电后以规定放电电流测得并由制造商申明的能量值。","同义词":"rated energy"}},
    {"type":"Terminology","name":"初始容量","properties":{"术语标准名称":"初始容量","术语标准定义":"新出厂动力电池完全充电后以规定电流放电至制造商规定终止条件时所放出的容量。","同义词":"initial capacity"}},
    {"type":"Terminology","name":"I3","properties":{"术语标准名称":"I3","术语标准定义":"3h率放电电流，其数值等于额定容量值的1/3。","同义词":"3h率放电电流"}},
    {"type":"Terminology","name":"I1","properties":{"术语标准名称":"I1","术语标准定义":"1h率放电电流，其数值等于额定容量值。","同义词":"1h率放电电流"}},
    {"type":"Clause","name":"1 范围条款","properties":{"唯一标识符":"IU-1-001","内容描述":"本文件规定电动汽车用动力蓄电池单体的电性能要求和相应试验方法，适用于装载在电动汽车上的锂离子电池和金属氢化物镍电池单体，其他类型电池参照执行。","条款类型":"陈述型","约束类型":"合规约束"}},
    {"type":"Clause","name":"2 规范性引用文件条款","properties":{"唯一标识符":"IU-2-001","内容描述":"规范性引用文件包括GB/T 10592—2023、GB/T 19596和GB 38031。","条款类型":"陈述型","约束类型":"合规约束"}},
    {"type":"Clause","name":"5.1 外观要求","properties":{"唯一标识符":"IU-5.1-001","内容描述":"电池单体按6.2.1检验，外观应无变形及裂纹，表面应无毛刺、干燥、无外伤、无污物，且应有清晰、正确的标志。","条款类型":"要求型","约束类型":"质量约束"}},
    {"type":"Clause","name":"5.2 极性标识要求","properties":{"唯一标识符":"IU-5.2-001","内容描述":"电池单体按6.2.2检验，端子极性标识应正确、清晰。","条款类型":"要求型","约束类型":"质量约束"}},
    {"type":"Clause","name":"5.3 质量和外形尺寸要求","properties":{"唯一标识符":"IU-5.3-001","内容描述":"电池单体按6.2.3检验，质量、外形尺寸应符合制造商提供的产品技术条件。","条款类型":"要求型","约束类型":"质量约束"}},
    {"type":"Clause","name":"5.4 室温放电容量要求","properties":{"唯一标识符":"IU-5.4-001","内容描述":"初始容量不得低于额定容量且不得超过额定容量的110%，初始容量极差不得大于初始容量平均值的5%。","条款类型":"要求型","约束类型":"质量约束"}},
    {"type":"Clause","name":"5.5 室温倍率放电容量要求","properties":{"唯一标识符":"IU-5.5-001","内容描述":"高能量电池放电容量不得低于初始容量的95%；高功率电池不得低于初始容量的80%。","条款类型":"要求型","约束类型":"质量约束"}},
    {"type":"Clause","name":"5.6 室温倍率充电性能要求","properties":{"唯一标识符":"IU-5.6-001","内容描述":"电池单体放电容量不得低于初始容量的80%。","条款类型":"要求型","约束类型":"质量约束"}},
    {"type":"Clause","name":"5.7 低温放电容量要求","properties":{"唯一标识符":"IU-5.7-001","内容描述":"锂离子电池放电容量不得低于初始容量的70%；金属氢化物镍电池不得低于初始容量的80%。","条款类型":"要求型","约束类型":"质量约束"}},
    {"type":"Clause","name":"5.8 高温放电容量要求","properties":{"唯一标识符":"IU-5.8-001","内容描述":"电池单体放电容量不得低于初始容量的95%。","条款类型":"要求型","约束类型":"质量约束"}},
    {"type":"Clause","name":"5.9 荷电保持与容量恢复能力要求","properties":{"唯一标识符":"IU-5.9-001","内容描述":"对锂离子和金属氢化物镍电池分别规定荷电保持容量、恢复容量及容量和能量效率极差要求。","条款类型":"要求型","约束类型":"质量约束"}},
    {"type":"Clause","name":"5.10 储存要求","properties":{"唯一标识符":"IU-5.10-001","内容描述":"恢复容量不得低于初始容量的95%，恢复容量极差和能量效率极差不得大于相应平均值的5%。","条款类型":"要求型","约束类型":"质量约束"}},
    {"type":"Clause","name":"6.1 试验条件条款","properties":{"唯一标识符":"IU-6.1-001","内容描述":"规定试验环境、仪器仪表准确度、测试过程误差及数据记录间隔。","条款类型":"要求型","约束类型":"流程约束"}},
    {"type":"Clause","name":"6.2 试验方法条款","properties":{"唯一标识符":"IU-6.2-001","内容描述":"规定外观、极性、质量尺寸、标准充电及各项容量、荷电保持和储存试验方法。","条款类型":"要求型","约束类型":"流程约束"}},
    {"type":"Clause","name":"6.3 试验项目条款","properties":{"唯一标识符":"IU-6.3-001","内容描述":"表1规定各试验项目对应的试验方法章条号、样品数量及编号。","条款类型":"陈述型","约束类型":"流程约束"}},
