@startuml Standard_Technical_Requirements_Ontology
title 标准技术要求独立抽取模块（源自总体本体）
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty methods

package "III. 技术要求、试验与外部资源包" <<Rectangle>> #FFF3E0 {
  ' 本模块可独立抽取技术条款、对象、特性、约束、试验及外部资源。
  ' Clause 与 InformationUnit 是最小上下文，不依赖内容结构模块。
  ' InformationUnit 与 Clause 由 Standard_Content_Structure_Ontology.puml 唯一定义。
  class "对象" <<Object>> { - 对象名称 (对象名称)\n- 对象类别 (对象类别) }
  class "标准对象" <<Subject of Standardization>>
  class "特性" <<Property>> { - 特性名称 (特性名称)\n- 特性类型 (特性类型)\n- 特性值 (特性值) }
  class "约束逻辑" <<Constrain>> { - 约束类型 (约束类型)\n- 最大值 (最大值)\n- 最小值 (最小值)\n- 阈值范围 (阈值范围)\n- 测量单位 (测量单位) }
  class "行动" <<ActionClass>>
  class "动作" <<Activity>>
  class "路径" <<Path>>
  class "判断条件" <<DecisionCriteria>>
  class "外部约束" <<ExternalResource>> { - 文件类型 (文件类型)\n- 生效时间 (生效时间)\n- 责任主体 (责任主体) }
  class "法规" <<Regulations>>
  class "文献" <<ReferencedDocuments>>
  class "专利" <<Patent>>
  class "公共数据库" <<PublicDatabase>>

  "条款" --|> "信息单元"
  "标准对象" --|> "对象"
  "动作" --|> "行动"
  "路径" --|> "行动"
  "判断条件" --|> "行动"
  "法规" --|> "外部约束"
  "文献" --|> "外部约束"
  "专利" --|> "外部约束"
  "公共数据库" --|> "外部约束"

  "对象" --> "特性" : hasCharacteristic <<hasCharacteristic>>
  "特性" --> "约束逻辑" : imposesConstraint <<imposesConstraint>>
  "约束逻辑" --> "特性" : constrainsCharacteristic <<constrainsCharacteristic>>
  "约束逻辑" --> "对象" : constrainsObject <<constrainsObject>>
  "条款" --> "对象" : involvesObject <<involvesObject>>
  "条款" --> "特性" : specifiesCharacteristic <<specifiesCharacteristic>>
  "信息单元" --> "行动" : describesAction <<describesAction>>
  "条款" --> "外部约束" : referencesExternalResource <<referencesExternalResource>>
}
@enduml
